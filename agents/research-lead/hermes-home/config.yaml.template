model:
  default: qwen2.5-14b-instruct
  provider: custom
  base_url: http://192.168.31.56:1234/v1
  api_key: not-needed
  context_length: 131072
agent:
  api_max_retries: 8
platforms:
  webhook:
    enabled: true
    extra:
      host: 127.0.0.1
      port: 8644
      routes:
        inbox:
          secret: ${DOOR_SECRET}
          prompt: "{message}"
platform_toolsets:
  webhook:
    - hermes-cli
_config_version: 12

auxiliary:
  background_review:
    enabled: false  # factory policy: no runtime self-improvement; skills change via PR only
