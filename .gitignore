# === Secrets — NEVER commit ===
.env
.env.*
!.env.example
crew/agents.json
tokens/tokens.yaml

# Rendered per-agent config (contains resolved secrets) + runtime state.
# hermes-home is foundation: only SOUL.md and config.yaml.template are tracked.
agents/*/hermes-home/config.yaml
agents/*/hermes-home/*
!agents/*/hermes-home/SOUL.md
!agents/*/hermes-home/config.yaml.template

# === Runtime / local ===
__pycache__/
*.pyc
*.py[cod]
.venv/
venv/
.DS_Store
*.log
*.sqlite
*.db

# === Workspace (project work lives outside foundation) ===
workspace/*
!workspace/.gitkeep

# === IDE ===
.idea/
.vscode/
*.swp
