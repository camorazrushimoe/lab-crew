# ============================================================
# Lab Crew — environment template (real values go in .env, which
# is NOT committed). Copy: cp .env.example .env
# ============================================================

# --- LLM (runinfra, one key shared by all agents) ---
CUSTOM_API_KEY=

# --- Instance id — qualifies container names ---
TEAM_NAME=lab-crew

# --- Per-agent door HMAC secrets (for agent-to-agent webhook comms) ---
DOOR_SECRET_RESEARCH_LEAD=
DOOR_SECRET_RESEARCH_ENGINEER=
DOOR_SECRET_EVALUATION=

# --- Optional host port overrides (defaults: 8651–8653) ---
# LAB_PORT_RESEARCH_LEAD=8671
# LAB_PORT_RESEARCH_ENGINEER=8672
# LAB_PORT_EVALUATION=8673

# --- Hermes process user inside containers ---
HERMES_UID=501
HERMES_GID=20
